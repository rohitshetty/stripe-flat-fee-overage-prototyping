# Stripe API Keys (from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook secret (from `stripe listen` command or Stripe Dashboard)
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs (run `npm run stripe:setup` to generate these)
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_EXPERT_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ADDON_SMALL_PRICE_ID=price_...
STRIPE_ADDON_MEDIUM_PRICE_ID=price_...
STRIPE_ADDON_LARGE_PRICE_ID=price_...

# Database
DATABASE_PATH=./data/prototype.db

# App URL (for Stripe redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# NATIVE IMPLEMENTATION (Stripe Meters)
# ============================================

# Stripe Meter ID (create via Dashboard or API)
# See: https://docs.stripe.com/billing/subscriptions/usage-based
STRIPE_METER_ID=mtr_...

# Separate webhook secret for native implementation
# Use a different endpoint: /api/native/webhooks/stripe
STRIPE_NATIVE_WEBHOOK_SECRET=whsec_...

# Native subscription prices (each tier has TWO prices: license + usage)
# License prices: Flat monthly fee (recurring)
# Usage prices: Tiered metered pricing linked to the meter

# Starter: $10/mo flat + $8/overage action
STRIPE_NATIVE_STARTER_LICENSE_PRICE_ID=price_...
STRIPE_NATIVE_STARTER_USAGE_PRICE_ID=price_...

# Expert: $15/mo flat + $6/overage action
STRIPE_NATIVE_EXPERT_LICENSE_PRICE_ID=price_...
STRIPE_NATIVE_EXPERT_USAGE_PRICE_ID=price_...

# Pro: $20/mo flat + $4/overage action
STRIPE_NATIVE_PRO_LICENSE_PRICE_ID=price_...
STRIPE_NATIVE_PRO_USAGE_PRICE_ID=price_...
